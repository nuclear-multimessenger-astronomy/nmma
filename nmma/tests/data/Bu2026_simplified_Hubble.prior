luminosity_distance = Uniform(minimum=1.0, maximum=200., name='luminosity_distance',latex_label='$D_L$')
timeshift = Uniform(minimum=-2.0, maximum=1.0, name='trigger_time',latex_label='$t_0$')
inclination_EM = DeltaFunction(np.pi/4., name="inclination_EM")
log10_mej_dyn = Uniform(minimum=-4.0, maximum=-1.31,  latex_label=r"$\log~M_{ej,dyn}$") 
v_ej_dyn = DeltaFunction(0.2, name="vej_dyn") 
Ye_dyn = DeltaFunction(0.25, name="Ye_dyn",latex_label="$Y_{e,dyn}$")
log10_mej_wind = Uniform(minimum=-4.0, maximum=-0.56, latex_label=r"$\log~M_{ej,wind}$")
v_ej_wind = 0.06
Ye_wind = 0.3
Hubble_constant = Uniform(name='H0', minimum=50., maximum=90., latex_label='$H_0$')