luminosity_distance = Uniform(minimum=1.0, maximum=200., name='luminosity_distance',latex_label='$D_L$')
timeshift = Uniform(minimum=-2.0, maximum=1.0, name='trigger_time',latex_label='$t_0$')
inclination_EM = Sine(name='inclination_EM', minimum=0., maximum=np.pi/2., latex_label=r'$\\iota$')
log10_mej_dyn = Uniform(minimum=-4.0, maximum=-1.31,  latex_label=r"$\log~M_{ej,dyn}$") 
v_ej_dyn = Uniform(name="vej_dyn", minimum=0.12, maximum=0.35, latex_label=r"$v_{ej,dyn}$") 
Ye_dyn = Uniform(name="Ye_dyn", minimum=0.15, maximum=0.35, latex_label="$Y_{e,dyn}$")
log10_mej_wind = Uniform(minimum=-4.0, maximum=-0.56, latex_label=r"$\log~M_{ej,wind}$")
v_ej_wind = Uniform(name="vej_wind", minimum=0.05, maximum=0.15, latex_label="$v_{ej,wind}$")
Ye_wind = Uniform(name="Ye_wind", minimum=0.2, maximum=0.4, latex_label="$Y_{e,wind}$")